# Keep the build context small and keep secrets out of image layers.
.git
.gitignore
.github
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache

# Nothing outside app/ belongs in the image
infra
k8s
charts
gitops
platform
docs
runbooks
loadtest
Makefile
README.md
LICENSE
SECURITY.md

# Never
*.tfvars
backend.hcl
.env
kubeconfig*
